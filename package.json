{
  "name": "bondfire-v2",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:public && npm run test:security && npm run test:product-reliability",
    "test:public": "node scripts/public-surface-regression.mjs",
    "test:security": "node scripts/auth-hardening-regression.mjs && node scripts/private-storage-regression.mjs && node scripts/private-key-scopes-regression.mjs && node scripts/private-encryption-reset-regression.mjs && node scripts/private-singleton-migration-regression.mjs && node scripts/private-submissions-regression.mjs && node scripts/private-publication-regression.mjs && node scripts/private-colophon-regression.mjs && node scripts/private-studio-regression.mjs && node scripts/security-boundary-regression.mjs && node scripts/security-data-integrity-regression.mjs && node scripts/emergency-protocol-regression.mjs",
    "test:product-reliability": "node scripts/product-reliability-regression.mjs",
    "smoke:thread1": "node scripts/thread1-emergency-smoke.mjs",
    "package:webapp": "node scripts/package-webapp.mjs",
    "desktop": "electron .",
    "desktop:dist": "electron-builder --publish never",
    "desktop:dist:win": "electron-builder --win nsis --x64",
    "desktop:dist:mac": "electron-builder --mac",
    "desktop:dist:linux": "electron-builder --linux",
    "desktop:dist:win:x64": "electron-builder --win nsis --x64 --publish never",
    "desktop:dist:win:arm64": "electron-builder --win nsis --arm64 --publish never",
    "desktop:dist:mac:x64": "electron-builder --mac --x64 --publish never",
    "desktop:dist:mac:arm64": "electron-builder --mac --arm64 --publish never",
    "desktop:dist:linux:x64": "electron-builder --linux --x64 --publish never",
    "desktop:dist:linux:arm64": "electron-builder --linux --arm64 --publish never"
  },
  "dependencies": {
    "colophon": "https://github.com/colophon-hub/colophon/archive/639561cd7a56d6c6d410767b43c0f0f4a28442eb.tar.gz",
    "lucide-react": "^0.577.0",
    "matrix-js-sdk": "^37.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.2",
    "react-masonry-css": "^1.0.16",
    "react-resizable": "^3.1.3",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.2",
    "vite-plugin-pwa": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "desktop/main.mjs",
  "build": {
    "appId": "org.bondfireapp.bondfire",
    "productName": "Bondfire",
    "asar": true,
    "files": [
      "desktop/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Bondfire-${version}-Windows-${arch}.${ext}",
      "icon": "public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "public/icons/icon-512.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Bondfire-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "icon": "public/icons/icon-512.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "artifactName": "Bondfire-${version}-Linux-${arch}.${ext}",
      "maintainer": "BondfireApp <329370031+BondfireApp@users.noreply.github.com>",
      "syncDesktopName": true
    }
  }
}
