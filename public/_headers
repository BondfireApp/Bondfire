/index.html
  Cache-Control: no-store

/
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/drive-share.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src blob: data:; frame-src blob:; connect-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'
